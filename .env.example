# Meeting Intelligence — Environment Configuration
# Copy this to .env and update values

# JWT Secret Key (change this to a strong random string in production!)
SECRET_KEY=meeting-intelligence-change-this-secret-key

# Server configuration
HOST=0.0.0.0
PORT=8000

# Whisper model size: tiny, base, small, medium, large
# Larger = better accuracy but slower (base recommended for CPU)
WHISPER_MODEL=base

# Max upload size in MB
MAX_FILE_SIZE_MB=500
